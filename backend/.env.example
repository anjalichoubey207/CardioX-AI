# CardioX AI Environment Configuration Template
NODE_ENV=production
PORT=5000
WS_PORT=5000

# Security (Set a strong 32+ character key in production)
JWT_SECRET=cardiox_clinical_jwt_secret_change_in_production
JWT_EXPIRATION=24h

# Optional MySQL Database (Leave unset to use high-speed in-memory database)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cardiox_db

# AI Analytics Service
AI_SERVICE_URL=http://localhost:8000
